# syntax=docker/dockerfile:1.7
# DrowAI Kali base image: shared OS/tooling layer for architecture-specific runtime images.

ARG KATANA_IMAGE=projectdiscovery/katana:v1.7.0@sha256:4e9fce12c507e1ca455baf493e14b899db5f2e0ed22ba62591aa42300487a947
FROM ${KATANA_IMAGE} AS katana

FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=katana /usr/local/bin/katana /usr/local/bin/katana

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        amass \
        bash \
        ca-certificates \
        cifs-utils \
        curl \
        dnsrecon \
        dnsutils \
        enum4linux-ng \
        ffuf \
        file \
        fping \
        ftp \
        gobuster \
        hydra \
        iproute2 \
        iputils-ping \
        iputils-tracepath \
        jq \
        ldap-utils \
        less \
        lftp \
        mariadb-client \
        masscan \
        mtr-tiny \
        musl \
        net-tools \
        netcat-traditional \
        ncat \
        nfs-common \
        nikto \
        nmap \
        nuclei \
        openssh-client \
        openvpn \
        php-cli \
        postgresql-client \
        python3 \
        python3-pip \
        redis-tools \
        rpcbind \
        rsync \
        sqlite3 \
        smbclient \
        snmp \
        socat \
        ssh-audit \
        sshpass \
        sslscan \
        sqlmap \
        swaks \
        tcpdump \
        telnet \
        tftp-hpa \
        tshark \
        unixodbc \
        util-linux \
        freetds-bin \
        unzip \
        wget \
        whois \
        whatweb \
        zip \
        7zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Kali's current Python dependency chain ships limits 4.4.1 beside packaging
# 26.2 and PyYAML metadata that pip 26 rejects. Overlay compatible wheels
# without removing the dpkg-owned packages.
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed --no-deps \
        limits==5.8.0 \
        PyYAML==6.0.3 \
    && python3 -m pip check

# Kali's Amass launcher downloads about 800 MB of optional libpostal data on
# every fresh task. Domain enumeration does not require that data.
RUN ln -sf /usr/lib/amass/amass /usr/local/bin/amass \
    && amass -version >/dev/null

# Ship a verified template snapshot so task-local Nuclei scans do not start
# with an empty ruleset or require an implicit network download.
RUN nuclei -update-templates -no-color \
    && test -d /root/.local/nuclei-templates \
    && test "$(find /root/.local/nuclei-templates -type f | wc -l)" -gt 0

RUN setcap -r /usr/lib/nmap/nmap 2>/dev/null || true

RUN set -eu; \
    python3 --version; \
    pip3 --version; \
    nmap --version >/dev/null; \
    katana -version >/dev/null 2>&1; \
    openvpn --version >/dev/null; \
    flock --version >/dev/null; \
    for binary in \
        amass dnsrecon enum4linux-ng hydra katana nuclei whatweb \
        fping nmap ftp lftp tftp ssh scp sftp sshpass rsync telnet smbclient rpcclient smbget \
        nc netcat ncat socat mtr tracepath showmount rpcinfo mount.cifs tcpdump tshark \
        file jq less zip unzip 7z php mysql psql sqlite3 redis-cli isql tsql \
        ldapsearch snmpwalk snmpcheck ssh-audit sslscan swaks; \
        do command -v "$binary" >/dev/null; done
